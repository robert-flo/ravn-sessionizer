# Config de ravn-sessionizer (bash). Copiala a /etc/ravn/sessionizer.conf
# (o apuntá RAVN_SESSIONIZER_CONFIG a otra ruta). Todo es opcional.

# Raíces cuyos hijos con .git aparecen en la lista (y los miembros de cada pj-*).
SES_ROOTS=(/z-drive/tries)
# Directorios sueltos que también aparecen.
SES_EXTRA=(/z/pj-omarchy)

# `trio` lista TODOS los issues abiertos de todos los miembros de todos los
# proyectos; los que tienen esta etiqueta van primero. Caché por repo (s).
SES_ISSUE_LABEL=ready-for-agent
SES_ISSUE_TTL=300

# Proyectos: repos pj-* de este dueño con proyecto.yml (se leen de GitHub,
# no hace falta tenerlos clonados). Caché de la lista en segundos.
SES_GITHUB_OWNER=robert-flo
SES_PJ_EXCLUDE=(pj-template)
SES_PROJECTS_TTL=3600

# Si el pj o el miembro del issue no está clonado, `trio` lo clona antes de
# lanzar el trío; si el clon ya existe en la raíz, lo actualiza con pull.
# Marcadores: {url} {repo} (dueño/nombre) {owner} {name}
# {root} (SES_CLONE_ROOT, o la primera de SES_ROOTS). Corre en {root}.
# Vacío = auto: `try exec --path {root} clone {url} | bash` (try-clone).
SES_CLONE_ROOT=""
SES_CLONE_CMD=""

# Vida media (días) del puntaje de frecencia.
SES_HALF_LIFE_DAYS=7

# Archivo (relativo al pj-*) con un miembro por línea; sin él se usan los
# repos git anidados en el pj-*.
SES_MEMBERS_FILE=.ravn/miembros

# Nombre de la primera tab al crear un workspace ("" = no renombrar).
SES_FIRST_TAB=main

# Lanzador de tríos.
SES_TRIO_BIN=pj-trio
