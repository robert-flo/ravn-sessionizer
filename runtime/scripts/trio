#!/usr/bin/env bash

# Trio command module: todos los issues abiertos de todos los miembros de
# todos los proyectos pj-* → enter lanza (o enfoca) el trío de ese issue.
# Proyectos y miembros salen de GitHub (proyecto.yml); lo que no esté
# clonado se clona con $SES_CLONE_CMD antes de lanzar.
set -Eeuo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$module_dir/../helper/set_variable.sh"
# shellcheck disable=SC1091
source "$SES_RUNTIME_DIR/lib/ses_common.sh"

usage() {
  print_header "ravn-sessionizer trio"
  printf '  %s\n' "Uso: ravn-sessionizer trio [--dry-run] [<pj>]" "" \
    "  Lista todos los issues abiertos de los miembros de cada pj-* ($SES_ISSUE_LABEL primero)." \
    "  <pj> (nombre o directorio) filtra a un solo proyecto." "" \
    "  enter   lanzar el trío del issue; si ya está abierto, lo enfoca" \
    "  ctrl-n  lanzar con el texto escrito como ticket, en el repo de la fila elegida" \
    "  ctrl-o  abrir el issue en el navegador" "  ctrl-r  refrescar (ignora la caché)" "" \
    "Ejecuta: $SES_TRIO_BIN start <pj> <ticket> --repo <miembro>"
}

dry_run=0
pj_arg=""
launch_args=()
while (($#)); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --dry-run) dry_run=1 ;;
    --launch)
      # (interno, lo usa `issues`/ri) lanzar sin fzf: <pj> <repo> <ticket>.
      (($# >= 4)) || { usage >&2; exit 2; }
      launch_args=("$2" "$3" "$4")
      shift 3
      ;;
    -*) usage >&2; exit 2 ;;
    *) pj_arg="$1" ;;
  esac
  shift
done

ses_require jq
ses_require gh
((${#launch_args[@]})) || ses_require_fzf

# Filtro opcional: nombre del pj (de un directorio, por su remoto).
pj_filter=""
if [[ -n $pj_arg ]]; then
  if [[ -d $pj_arg ]]; then
    pj_filter="$(ses_remote_slug "$pj_arg" 2> /dev/null || basename "$pj_arg")"
  else
    pj_filter="$pj_arg"
  fi
  pj_filter="${pj_filter#*/}"
fi
printf -v bin '%q' "$SES_BIN"

# Etiqueta de herdr que pone pj-trio: "trio <pj>#N" o "trio <pj>/<miembro>#N".
trio_label() {
  local pj="${1#*/}" repo="${2#*/}" num="$3"
  if [[ $repo == "$pj" ]]; then printf 'trio %s#%s\n' "$pj" "$num"; else printf 'trio %s/%s#%s\n' "$pj" "$repo" "$num"; fi
}

issue_rows() {
  local json="$1" open_labels
  open_labels="$(ses_trio_labels | jq -R . | jq -s .)"
  jq -r --arg f "$pj_filter" --argjson open "$open_labels" --arg label "$SES_ISSUE_LABEL" \
    --arg w "$S_WHITE" --arg g "$S_GRAY" --arg c "$S_CYAN" --arg y "$S_YELLOW" --arg gr "$S_GREEN" --arg n "$S_NC" --arg icon "$SES_ICON_ISSUE" '
    .[]
    | select($f == "" or (.pj | split("/")[1] | ascii_downcase) == ($f | ascii_downcase))
    | (.number | tostring) as $num
    | (.pj | split("/")[1]) as $pj | (.repo | split("/")[1]) as $repo
    | (if $repo == $pj then "trio " + $pj + "#" + $num else "trio " + $pj + "/" + $repo + "#" + $num end) as $lbl
    | (any($open[]; . == $lbl)) as $running
    | (any(.labels[]?; .name == $label)) as $ready
    | ["issue", .pj + "|" + .repo + "|" + $num,
       (if $ready then $gr else $c end) + $icon + $n + "  " + $w + $repo + " #" + $num + $n + "  " + .title
       + "  " + $g + $pj
       + (if (.labels | length) > 0 then " · " + ([.labels[].name] | join(" ")) else "" end) + $n
       + (if $running then "  " + $y + "● trío abierto" + $n else "" end)]
    | @tsv' <<< "$json"
}

focus_label() {
  local ws
  # shellcheck disable=SC2034 # lo lee ses_snapshot (snapshot fresco)
  SES_SNAPSHOT=""
  ws="$(ses_snapshot | jq -r --arg l "$1" '.result.snapshot.workspaces[] | select(.label == $l) | .workspace_id' 2> /dev/null | head -n1)"
  [[ -n $ws ]] || return 1
  "$HERDR" workspace focus "$ws" > /dev/null
}

launch() {
  local pj="$1" repo="$2" ticket="$3" label pj_dir repo_dir
  label="$(trio_label "$pj" "$repo" "$ticket")"
  if ((!dry_run)) && focus_label "$label"; then
    print_info "ya estaba abierto: $label"
    return 0
  fi
  if ! pj_dir="$(ses_find_local "$pj")"; then
    if ((dry_run)); then print_info "[dry-run] clonaría $pj"; pj_dir="<$pj>"; else
      pj_dir="$(ses_clone "$pj")" || ses_fail "no pude clonar $pj (SES_CLONE_CMD=$SES_CLONE_CMD)"
    fi
  elif (( ! dry_run )) && [[ -d $pj_dir/.git ]]; then
    ses_pull "$pj_dir" || print_warn "no pude actualizar $pj; sigo con el clon actual"
  fi
  repo_dir=""
  if [[ ${repo,,} != "${pj,,}" ]] && ! repo_dir="$(ses_find_local "$repo")"; then
    if ((dry_run)); then print_info "[dry-run] clonaría $repo"; repo_dir="<$repo>"; else
      repo_dir="$(ses_clone "$repo")" || ses_fail "no pude clonar $repo (SES_CLONE_CMD=$SES_CLONE_CMD)"
    fi
  elif [[ -n $repo_dir ]] && (( ! dry_run )) && [[ -d $repo_dir/.git ]]; then
    ses_pull "$repo_dir" || print_warn "no pude actualizar $repo; sigo con el clon actual"
  fi
  cmd=("$SES_TRIO_BIN" start)
  ((dry_run)) && cmd+=(--dry-run)
  cmd+=("$pj_dir" "$ticket")
  [[ -n $repo_dir ]] && cmd+=(--repo "$repo_dir")
  print_step "${cmd[*]}"
  [[ $pj_dir == /* ]] && ses_record_history "$pj_dir"
  "${cmd[@]}" || ses_fail "$SES_TRIO_BIN falló para $label"
  ((dry_run)) || focus_label "$label" || true
}

if ((${#launch_args[@]})); then
  launch "${launch_args[@]}"
  exit 0
fi

force=0
while true; do
  rc=0
  json="$(ses_all_issues_json "$force")" || rc=$?
  force=0
  header="enter lanzar/enfocar · ctrl-n ticket escrito · ctrl-o navegador · ctrl-r refrescar"
  ((rc == 3)) && header="${S_YELLOW}⚠ gh falló en algún repo: parte de los issues sale de la caché o falta${S_NC}"$'\n'"$header"

  out_rc=0
  out="$(issue_rows "$json" | ses_fzf --print-query --expect ctrl-n,ctrl-o,ctrl-r \
    --prompt "${pj_filter:-issues} › " --border-label " trío · issues " --header "$header" \
    --preview "$bin preview {1} {2}")" || out_rc=$?
  ((out_rc == 130)) && exit 0
  query="$(sed -n 1p <<< "$out")"
  key="$(sed -n 2p <<< "$out")"
  selection="$(sed -n 3p <<< "$out")"
  [[ $key == ctrl-r ]] && { force=1; continue; }
  if [[ $(cut -f1 <<< "$selection") != issue ]]; then
    [[ -z $selection ]] && exit 0
    continue
  fi
  IFS='|' read -r pj repo num <<< "$(cut -f2 <<< "$selection")"
  case "$key" in
    ctrl-o)
      gh issue view "$num" -R "$repo" --web > /dev/null 2>&1 || true
      continue
      ;;
    ctrl-n) ticket="${query#\#}" ;;
    *) ticket="$num" ;;
  esac
  if [[ ! $ticket =~ ^[0-9A-Za-z._-]+$ ]]; then
    print_warn "ticket inválido: «$ticket» (solo letras, números, . _ -)"
    sleep 1
    continue
  fi
  launch "$pj" "$repo" "$ticket"
  if ((dry_run)) && [[ -n ${HERDR_PLUGIN_ID:-} ]]; then
    read -rsn1 -p "tecla para cerrar…" || true
  fi
  exit 0
done
