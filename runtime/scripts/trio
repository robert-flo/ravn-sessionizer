#!/usr/bin/env bash

# Trio command module: issues ready-for-agent de un pj-* → miembro → pj-trio.
# El pj-* sale del argumento, del pane enfocado o de un picker de solo pj-*.
set -Eeuo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$module_dir/../helper/set_variable.sh"
# shellcheck disable=SC1091
source "$SES_RUNTIME_DIR/lib/ses_common.sh"

usage() {
  print_header "ravn-sessionizer trio"
  printf '  %s\n' "Uso: ravn-sessionizer trio [--dry-run] [<pj>]" "" \
    "  enter   lanzar el trío del issue (o del número escrito en la fila «ticket nuevo»)" \
    "  ctrl-n  lanzar con el texto escrito como ticket, sin issue" \
    "  ctrl-o  abrir el issue en el navegador" "  ctrl-r  refrescar issues (ignora la caché)" "" \
    "Ejecuta: $SES_TRIO_BIN start <pj> <ticket> [--repo <miembro>]"
}

dry_run=0
pj_arg=""
while (($#)); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --dry-run) dry_run=1 ;;
    -*) usage >&2; exit 2 ;;
    *) pj_arg="$1" ;;
  esac
  shift
done

ses_require jq
ses_require gh
ses_require_fzf

resolve_pj() {
  local candidate root
  if [[ -n $pj_arg ]]; then
    if [[ -d $pj_arg ]]; then
      (cd "$pj_arg" && pwd)
      return
    fi
    for root in "${SES_ROOTS[@]}"; do
      [[ -d $root/$pj_arg ]] && { printf '%s\n' "$root/$pj_arg"; return; }
    done
    ses_fail "no encuentro el pj: $pj_arg"
  fi
  candidate="$(ses_context_cwd)"
  [[ -n $candidate ]] && candidate="$(ses_pj_of "$candidate" || true)"
  printf '%s\n' "$candidate"
}

pj="$(resolve_pj)"
if [[ -z $pj ]]; then
  # Sin contexto: elegir el pj-* (enter vuelve acá con el pj elegido).
  exec "$SES_RUNTIME_DIR/scripts/pick" pj
fi
ses_is_pj "$pj" || ses_fail "no es un meta-repo pj-*: $pj"
export SES_PJ="$pj"
pj_name="$(basename "$pj")"
printf -v bin '%q' "$SES_BIN"

issue_rows() {
  local json="$1" open_labels
  open_labels="$(ses_trio_labels | jq -R . | jq -s .)"
  ses_row new - "${S_GREEN}${SES_ICON_NEW}${S_NC}  ${S_GRAY}ticket nuevo: escribí el número y enter (o ctrl-n)${S_NC}"
  jq -r --arg pj "$pj_name" --argjson open "$open_labels" \
    --arg w "$S_WHITE" --arg g "$S_GRAY" --arg c "$S_CYAN" --arg y "$S_YELLOW" --arg n "$S_NC" --arg icon "$SES_ICON_ISSUE" '
    .[]
    | (.number | tostring) as $num
    | ([$open[] | select(test("^trio " + $pj + "(/[^#]*)?#" + $num + "$"))] | length > 0) as $running
    | ["issue", $num,
       $c + $icon + $n + "  " + $w + "#" + $num + $n + "  " + .title
       + (if (.labels | length) > 0 then "  " + $g + ([.labels[].name] | join(" ")) + $n else "" end)
       + (if $running then "  " + $y + "● trío abierto" + $n else "" end)]
    | @tsv' <<< "$json"
}

pick_member() {
  local ticket="$1" json="$2" preferred member
  local -a members=()
  mapfile -t members < <(ses_members "$pj")
  ((${#members[@]})) || return 0
  preferred="$(jq -r --arg n "$ticket" '.[] | select((.number | tostring) == $n) | .labels[].name
    | select(startswith("repo:")) | sub("^repo:"; "")' <<< "$json" 2> /dev/null | head -n1)"
  {
    for member in "${members[@]}"; do
      [[ -n $preferred && $(basename "$member") == "$preferred" ]] && dir_member_row "$member"
    done
    ses_row none - "${S_GRAY}(sin miembro: el trío trabaja en el meta-repo)${S_NC}"
    for member in "${members[@]}"; do
      [[ -n $preferred && $(basename "$member") == "$preferred" ]] || dir_member_row "$member"
    done
  } | ses_fzf --prompt "miembro › " --border-label " $pj_name#$ticket " \
    --header "¿en qué repo miembro trabaja el trío? · esc vuelve" \
    --preview "$bin preview {1} {2}" | cut -f2
}

dir_member_row() {
  ses_row dir "$1" "${S_CYAN}${SES_ICON_MEMBER}${S_NC}  ${S_WHITE}$(basename "$1")${S_NC}"
}

force=0
while true; do
  rc=0
  json="$(ses_issues_json "$pj" "$force")" || rc=$?
  force=0
  header="enter lanzar · ctrl-n ticket escrito · ctrl-o navegador · ctrl-r refrescar"
  case "$rc" in
    3) header="${S_YELLOW}⚠ gh falló: issues de la caché (pueden estar viejos)${S_NC}"$'\n'"$header" ;;
    1) json="[]" header="${S_YELLOW}⚠ sin issues: gh falló y no hay caché${S_NC}"$'\n'"$header" ;;
  esac

  out_rc=0
  out="$(issue_rows "$json" | ses_fzf --print-query --expect ctrl-n,ctrl-o,ctrl-r \
    --prompt "$pj_name › " --border-label " $SES_ISSUE_LABEL " --header "$header" \
    --preview "$bin preview {1} {2}")" || out_rc=$?
  ((out_rc == 130)) && exit 0
  query="$(sed -n 1p <<< "$out")"
  key="$(sed -n 2p <<< "$out")"
  selection="$(sed -n 3p <<< "$out")"
  kind="$(cut -f1 <<< "$selection")"

  case "$key" in
    ctrl-r) force=1; continue ;;
    ctrl-o)
      if [[ $kind == issue ]]; then
        (cd "$pj" && gh issue view "$(cut -f2 <<< "$selection")" --web > /dev/null 2>&1) || true
      fi
      continue
      ;;
    ctrl-n) ticket="$query" ;;
    *)
      if [[ $kind == issue ]]; then
        ticket="$(cut -f2 <<< "$selection")"
      else
        ticket="$query"
      fi
      ;;
  esac
  ticket="${ticket#\#}"
  if [[ ! $ticket =~ ^[0-9A-Za-z._-]+$ ]]; then
    [[ -z $ticket ]] && ((out_rc != 0)) && exit 0
    print_warn "ticket inválido: «$ticket» (solo letras, números, . _ -)"
    sleep 1
    continue
  fi

  member_rc=0
  member="$(pick_member "$ticket" "$json")" || member_rc=$?
  ((member_rc == 130)) && continue
  [[ $member == - ]] && member=""

  cmd=("$SES_TRIO_BIN" start)
  ((dry_run)) && cmd+=(--dry-run)
  cmd+=("$pj" "$ticket")
  [[ -n $member ]] && cmd+=(--repo "$member")
  print_step "${cmd[*]}"
  ses_record_history "$pj"
  if ! "${cmd[@]}"; then
    ses_fail "$SES_TRIO_BIN falló para $pj_name#$ticket"
  fi
  if ((dry_run)) && [[ -n ${HERDR_PLUGIN_ID:-} ]]; then
    read -rsn1 -p "tecla para cerrar…" || true
  fi
  exit 0
done
