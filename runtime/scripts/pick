#!/usr/bin/env bash

# Pick command module: un solo fzf para workspaces abiertos, repos y pj-*.
# enter abre (pj-* → issues ready-for-agent), alt-enter abre el workspace del
# pj-*, tab alterna con la vista de agentes, ctrl-r refresca.
set -Eeuo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$module_dir/../helper/set_variable.sh"
# shellcheck disable=SC1091
source "$SES_RUNTIME_DIR/lib/ses_common.sh"

usage() {
  print_header "ravn-sessionizer pick"
  printf '  %s\n' "Uso: ravn-sessionizer [pick] [workspaces|agents|pj]" \
    "" "  enter      abrir (en un pj-*: elegir issue y lanzar el trío)" \
    "  alt-enter  abrir el workspace del pj-* sin trío" \
    "  tab        alternar workspaces ⇄ agentes" "  ctrl-r     refrescar"
}

view="${1:-workspaces}"
case "$view" in
  -h | --help) usage; exit 0 ;;
  workspaces | agents | pj) ;;
  *) usage >&2; exit 2 ;;
esac

ses_require jq
ses_require_fzf

prompt="workspace › "
[[ $view == agents ]] && prompt="agentes › "
[[ $view == pj ]] && prompt="pj › "
printf -v bin '%q' "$SES_BIN"

binds=(--bind "ctrl-r:transform:$bin list --refresh")
[[ $view != pj ]] && binds+=(--bind "tab:transform:$bin list --toggle")

out="$("$SES_BIN" list "$view" | ses_fzf \
  --prompt "$prompt" --border-label ' ravn · sessionizer ' \
  --header "enter abrir · alt-enter workspace del pj · tab agentes⇄workspaces · ctrl-r refrescar" \
  --expect alt-enter "${binds[@]}" \
  --preview "$bin preview {1} {2}")" || exit 0

key="$(sed -n 1p <<< "$out")"
selection="$(sed -n 2p <<< "$out")"
[[ -n $selection ]] || exit 0
kind="$(cut -f1 <<< "$selection")"
target="$(cut -f2 <<< "$selection")"

case "$kind" in
  ws) ses_focus_ws "$target" ;;
  agent) ses_focus_agent "$target" ;;
  dir) ses_open_dir "$target" ;;
  pj)
    if [[ $key == alt-enter ]]; then
      ses_open_dir "$target"
    else
      exec "$SES_BIN" trio "$target"
    fi
    ;;
  *) ses_fail "fila desconocida: $kind" ;;
esac
