#!/usr/bin/env bash

# Sessions command module: selector fzf de sesiones herdr inspirado en `bin/t`.
# Separa con `———` Estables (HR-*, scratchpad), Efímeras (specs) y directorios
# disponibles exclusivamente en /z-home-repos/HR-*.
# ctrl-s alterna todas ⇄ solo activas (running); distingue attached vs detached.
set -Eeuo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$module_dir/../helper/set_variable.sh"
# shellcheck disable=SC1091
source "$SES_RUNTIME_DIR/lib/ses_common.sh"

readonly PROMPT_SESSIONS="sesiones › "
readonly PROMPT_ACTIVE="activas › "

usage() {
  print_header "ravn-sessionizer sessions"
  printf '  %s\n' "Uso: ravn-sessionizer sessions [--active]" \
    "" "  enter      attach a sesión existente o crear nueva desde /z-home-repos/HR-*" \
    "  ctrl-s     alternar todas ⇄ solo sesiones activas" \
    "  ctrl-r     refrescar"
}

fzf_action() {
  local kind="$1" flag="" prompt="$PROMPT_SESSIONS" bin
  case "$kind:${FZF_PROMPT:-}" in
    toggle:"$PROMPT_SESSIONS") flag=" --active" prompt="$PROMPT_ACTIVE" ;;
    refresh:"$PROMPT_ACTIVE") flag=" --active" prompt="$PROMPT_ACTIVE" ;;
  esac
  printf -v bin '%q' "$SES_BIN"
  printf 'reload(%s sessions --list%s)+change-prompt(%s)\n' "$bin" "$flag" "$prompt"
}

mode=pick
active_only=0
while (($#)); do
  case "$1" in
    -h | --help) usage; exit 0 ;;
    --active) active_only=1 ;;
    --list) mode=list ;;
    --toggle) mode=toggle ;;
    --refresh) mode=refresh ;;
    *) usage >&2; exit 2 ;;
  esac
  shift
done

ses_require jq

case "$mode" in
  list)
    ses_session_rows "$active_only"
    exit 0
    ;;
  toggle | refresh)
    fzf_action "$mode"
    exit 0
    ;;
esac

ses_require_fzf

prompt="$PROMPT_SESSIONS"
list_args=(sessions --list)
if ((active_only)); then
  prompt="$PROMPT_ACTIVE"
  list_args+=(--active)
fi
printf -v bin '%q' "$SES_BIN"

selection="$("$SES_BIN" "${list_args[@]}" | ses_fzf \
  --prompt "$prompt" --border-label ' ravn · sessions ' \
  --header "enter attach/crear · ctrl-s solo activas ⇄ todas · ctrl-r refrescar" \
  --bind "ctrl-s:transform:$bin sessions --toggle" \
  --bind "ctrl-r:transform:$bin sessions --refresh" \
  --preview "$bin preview {1} {2}")" || exit 0

[[ -n $selection ]] || exit 0
kind="$(cut -f1 <<< "$selection")"
target="$(cut -f2 <<< "$selection")"
ses_session_open "$kind" "$target"
