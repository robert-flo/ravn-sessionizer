#!/usr/bin/env bash

# Open command module: enfoca el workspace de un directorio o lo crea.
set -Eeuo pipefail

module_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$module_dir/../helper/set_variable.sh"
# shellcheck disable=SC1091
source "$SES_RUNTIME_DIR/lib/ses_common.sh"

if [[ $# -ne 1 || $1 == -h || $1 == --help ]]; then
  print_header "ravn-sessionizer open"
  printf '  %s\n' "Uso: ravn-sessionizer open <directorio>" \
    "Reusa el workspace con ese label o con un pane en ese cwd; si no existe, lo crea."
  [[ $# -eq 1 ]] && exit 0 || exit 2
fi
ses_require jq
ses_open_dir "$1"
